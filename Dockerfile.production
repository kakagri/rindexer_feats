# Production-optimized Dockerfile for rindexer
# Includes caching optimizations and smaller final image

# Build stage with cargo-chef for dependency caching
FROM --platform=linux/amd64 rust:1.88.0-bookworm as planner
RUN cargo install cargo-chef
WORKDIR /app
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Cook dependencies separately for better caching
FROM --platform=linux/amd64 rust:1.88.0-bookworm as cacher
RUN cargo install cargo-chef
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - && \
    apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    clang \
    libclang-dev \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json --features jemalloc,reth

# Build the application
FROM --platform=linux/amd64 rust:1.88.0-bookworm as builder
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - && \
    apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    clang \
    libclang-dev \
    nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
# Copy pre-built dependencies
COPY --from=cacher /app/target target
COPY --from=cacher $CARGO_HOME $CARGO_HOME

# Build with aggressive optimizations
RUN RUSTFLAGS='-C target-cpu=x86-64-v3 -C opt-level=3 -C lto=fat -C codegen-units=1' \
    cargo build --release --features jemalloc,reth --workspace --exclude rindexer_rust_playground

# Strip debug symbols for smaller binary
RUN strip /app/target/release/rindexer_cli

# Final stage - minimal runtime
FROM --platform=linux/amd64 gcr.io/distroless/cc-debian12
COPY --from=builder /app/target/release/rindexer_cli /app/rindexer

# For Foundry support, use debian:bookworm-slim instead of distroless
# and uncomment the following:
# FROM --platform=linux/amd64 debian:bookworm-slim
# RUN apt-get update && apt-get install -y \
#     libssl3 \
#     ca-certificates \
#     curl \
#     git \
#     && rm -rf /var/lib/apt/lists/*
# RUN curl -L https://foundry.paradigm.xyz | bash
# RUN /root/.foundry/bin/foundryup
# COPY --from=builder /app/target/release/rindexer_cli /app/rindexer

ENTRYPOINT ["/app/rindexer"]